{
  "name": "opencode-tailscale",
  "version": "0.0.6",
  "description": "Tailscale settings and mobile pairing for OpenCode Desktop.",
  "keywords": [
    "opencode-plugin"
  ],
  "homepage": "https://github.com/vestia-dev/opencode-tailscale#readme",
  "bugs": {
    "url": "https://github.com/vestia-dev/opencode-tailscale/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vestia-dev/opencode-tailscale.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "prepack": "npm run build",
    "prepare": "effect-tsgo patch --oxlint",
    "lint": "oxfmt --write . && oxlint --type-aware --type-check --deny-warnings .",
    "check": "npm run lint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.0",
    "@opencode/plugin": "^2.2.7",
    "@types/node": "^24.19.2",
    "effect": "^4.1.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2001",
    "solid-js": "^1.9.19",
    "typescript": "7.0.2",
    "uqr": "^0.1.3",
    "vite": "^7.3.8",
    "vite-plugin-solid": "^2.11.16"
  }
}
